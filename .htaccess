
RewriteEngine on
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^amputeerehabsummit\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.amputeerehabsummit\.org$
RewriteRule ^/?$ "https\:\/\/amputeerehabsummit\.org\/" [R=301,L]

# Never let browsers/mobile cache the HTML itself - always fetch the latest version
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
